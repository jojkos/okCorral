{
  "name": "ok-corral",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:animations": "vite build --config vite.animations.config.ts",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node --import tsx --test tests/sync.test.ts tests/gameplay.test.ts tests/music.test.ts tests/recordedMusic.test.ts tests/gatlingCollision.test.ts tests/rain.test.ts tests/eventSettings.test.ts tests/animations.test.ts tests/motionPreferences.test.ts",
    "test:network": "node --import tsx tests/network.integration.ts"
  },
  "dependencies": {
    "tsx": "^4.6.0",
    "clsx": "^2.1.1",
    "express": "^4.18.2",
    "lucide-react": "^0.563.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
